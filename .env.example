# Copy to .env and run with `uv run --env-file .env gentrex ...`.
# .env is gitignored.

# OpenAI-compatible endpoint serving the OCR vision model (stage 1).
GENTREX_OCR_BASE_URL=http://localhost:8000/v1
GENTREX_OCR_API_KEY=EMPTY

# OpenAI-compatible endpoint serving the text model (stages 2 and 3).
GENTREX_LLM_BASE_URL=http://localhost:8000/v1
GENTREX_LLM_API_KEY=EMPTY

# Database that the reports are loaded into (stage 5). A SQLite file needs no
# server. For a PostgreSQL or MySQL server, see docs/stage5.md, step 2.
GENTREX_DATABASE_URL=sqlite:///results/load/gentrex.db
