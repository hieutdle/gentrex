# Copy to .env and run with `uv run --env-file .env gentrex ...`.
# .env is gitignored.

# OpenAI-compatible endpoint serving the OCR vision model
# (`gentrex transcribe`).
GENTREX_OCR_BASE_URL=http://localhost:8000/v1
GENTREX_OCR_API_KEY=EMPTY

# OpenAI-compatible endpoint serving the text model (`gentrex select` and
# `gentrex extract`).
GENTREX_LLM_BASE_URL=http://localhost:8000/v1
GENTREX_LLM_API_KEY=EMPTY

# Database that `gentrex load` writes the reports into. A SQLite file needs
# no server. For a PostgreSQL or MySQL server, see docs/load.md, step 2.
GENTREX_DATABASE_URL=sqlite:///results/load/gentrex.db
