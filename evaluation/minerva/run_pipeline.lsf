#!/bin/bash
# Run Gentrex on the benchmark reports in a Minerva job, and score it.
# Submit it from the gentrex folder, after evaluation/minerva/prepare.sh:
#
#   SERVING=/path/to/serving bsub -P acc_xxx < evaluation/minerva/run_pipeline.lsf
#
# submit_pipeline.sh submits the same runs as seven short jobs instead, which
# wait less in the queue. run_pipeline_b200.lsf makes them on one B200 GPU.
#
# gentrex-bench/run.py runs gentrex transcribe, select, extract and normalize
# on each copy of the reports and scores the records. It serves the model of
# each command with serve.sh, one after another, so the job holds the two
# GPUs of gentrex extract for its whole time. The scores go to
# results/gentrex-bench/, one folder for each run.
#
# By default the job makes seven runs of the benchmark reports: native (3 runs
# for repeatability, the first with --select-methods), scan, fax, native
# without gentrex select, and native with Gemma 4 26B-A4B as the extraction
# model (evaluation/settings-extract-26b.yaml). VERSION names the benchmark version (v1), COPIES
# the copies to read, NO_SELECT the copies to read once more without gentrex
# select (native, and NO_SELECT= for none), SELECT_METHODS the copies whose
# pages are also chosen in two other ways (native, and SELECT_METHODS= for
# none), REPEATS total runs of REPEAT_COPY (3 on native, set REPEATS=1 for
# none), EXTRACT_26B the copies to read once more with the 26B extraction
# model (native, and EXTRACT_26B= for none), and OPTIONS extra options of run.py for every run. The job fails if
# a command had failed files, after the scores are written.
#BSUB -J gentrex-pipeline
#BSUB -q gpu
#BSUB -n 4
#BSUB -W 8:00
#BSUB -gpu num=2
#BSUB -R "select[h100nvl] rusage[mem=8000] span[hosts=1]"
#BSUB -oo run-pipeline.%J.log
: "${SERVING:?set SERVING to the serving folder}"
[ -f gentrex-bench/run.py ] || { echo "submit the job from the gentrex folder"; exit 1; }

module load apptainer
status=0
run() {
  # --gpus names the GPUs that serve.sh gives each model. EXTRACT_GPUS is the
  # number for the model of gentrex extract, 2 unless the job sets it.
  .venv/bin/python gentrex-bench/run.py \
    --version "${VERSION:-v1}" \
    --gpus 1 1 "${EXTRACT_GPUS:-2}" --serve evaluation/minerva/serve.sh \
    --settings evaluation/settings.yaml $OPTIONS "$@" || status=1
}
for copy in ${COPIES:-native scan fax}; do
  case " ${SELECT_METHODS-native} " in
    *" $copy "*) run --copy "$copy" --select-methods ;;
    *) run --copy "$copy" ;;
  esac
  if [ "$copy" = "${REPEAT_COPY:-native}" ]; then
    n="${REPEATS:-3}"
    while [ "$n" -gt 1 ]; do
      run --copy "$copy"
      n=$((n - 1))
    done
  fi
done
case " $OPTIONS " in
  *" --no-select "*) ;;
  *) for copy in ${NO_SELECT-native}; do run --copy "$copy" --no-select; done ;;
esac
# Later options of run.py replace the earlier ones of run().
for copy in ${EXTRACT_26B-native}; do
  run --copy "$copy" --settings evaluation/settings-extract-26b.yaml \
    --gpus 1 1 1 --label extract-26B-A4B
done
# Every scored run, so that the log ends with the results.
.venv/bin/python gentrex-bench/scorer/score.py --list
exit $status
