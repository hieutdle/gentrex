#!/bin/bash
# Run Gentrex on the benchmark reports in a Minerva job on one B200 GPU.
# Submit it from the gentrex folder, after evaluation/minerva/prepare.sh:
#
#   SERVING=/path/to/serving bsub -P acc_xxx < evaluation/minerva/run_pipeline_b200.lsf
#
# It makes the runs of run_pipeline.lsf and reads the same variables. A B200
# has about 180 GB of memory, so it holds the model of gentrex extract alone,
# and the job asks for one GPU instead of two H100s. b200 in the -R line is
# the tag of the B200 nodes, which `lshosts lg01e03` lists under RESOURCES.
#BSUB -J gentrex-pipeline
#BSUB -q gpu
#BSUB -n 4
#BSUB -W 8:00
#BSUB -gpu num=1
#BSUB -R "select[b200] rusage[mem=8000] span[hosts=1]"
#BSUB -oo run-pipeline.%J.log
export EXTRACT_GPUS=1
. evaluation/minerva/run_pipeline.lsf
